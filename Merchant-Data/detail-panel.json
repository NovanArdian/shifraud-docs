ke-width=\"2.5\"><rect x=\"1\" y=\"4\" width=\"22\" height=\"16\" rx=\"2\" ry=\"2\"/></svg>Account Info</div><div style=\"display:grid;grid-template-columns:1fr 1fr;gap:8px;\"><div><div style=\"font-size:7.5px;font-weight:800;color:#94a3b8;text-transform:uppercase;letter-spacing:.5px;\">Account Number</div><div style=\"font-size:9px;font-weight:700;color:#0f172a;margin-top:2px;font-family:monospace;\">1234567890</div></div><div><div style=\"font-size:7.5px;font-weight:800;color:#94a3b8;text-transform:uppercase;letter-spacing:.5px;\">Type</div><div style=\"font-size:9px;font-weight:700;color:#0f172a;margin-top:2px;\">SAVINGS</div></div><div><div style=\"font-size:7.5px;font-weight:800;color:#94a3b8;text-transform:uppercase;letter-spacing:.5px;\">Status</div><div style=\"font-size:9px;font-weight:700;color:#10b981;margin-top:2px;\">ACTIVE</div></div><div><div style=\"font-size:7.5px;font-weight:800;color:#94a3b8;text-transform:uppercase;letter-spacing:.5px;\">Currency</div><div style=\"font-size:9px;font-weight:700;color:#0f172a;margin-top:2px;\">IDR</div></div></div></div></div></div>"
