            "1": "<div style=\"font-family:system-ui,-apple-system,sans-serif;border-radius:14px;box-shadow:0 1px 2px rgba(0,0,0,.04),0 1px 6px rgba(0,0,0,.06);background:#fff;border:1px solid #bfdbfe;overflow:hidden;padding:14px 16px;display:flex;gap:8px;flex-wrap:wrap;justify-content:center;\"><span style=\"padding:6px 14px;border-radius:7px;background:#eff6ff;border:1px solid #bfdbfe;font-size:10px;font-weight:600;color:#2563eb;\">🖱️ Klik</span><span style=\"padding:6px 14px;border-radius:7px;background:#eff6ff;border:1px solid #bfdbfe;font-size:10px;font-weight:600;color:#2563eb;\">⇧ Shift+Klik</span><span style=\"padding:6px 14px;border-radius:7px;background:#eff6ff;border:1px solid #bfdbfe;font-size:10px;font-weight:600;color:#2563eb;\">📐 Drag box</span><span style=\"padding:6px 14px;border-radius:7px;background:#eff6ff;border:1px solid #bfdbfe;font-size:10px;font-weight:600;color:#2563eb;\">⌨ Ctrl+A</span></div>"
