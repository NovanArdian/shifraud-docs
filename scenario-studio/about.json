<svg width=\"10\" height=\"10\" viewBox=\"0 0 24 24\" fill=\"#cbd5e1\"><circle cx=\"12\" cy=\"12\" r=\"6\"/></svg><span style=\"font-size:9px;color:#94a3b8;\">Review &amp; Submit</span></div></div><div style=\"margin-top:4px;font-size:8px;color:#f59e0b;font-weight:600;\">4 langkah + attr binding</div></div></div></div><div style=\"margin-top:10px;padding:8px 10px;border-radius:6px;background:#f1f5f9;border:1px solid #e2e8f0;display:flex;align-items:center;gap:6px;\"><svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#6366f1\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"M12 16v-4M12 8h.01\"/></svg><span style=\"font-size:9px;color:#475569;\">Dua tipe rule dengan jumlah langkah berbeda</span></div></div>"
