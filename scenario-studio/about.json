lor:#fff;\">CONDITION</span><span style=\"margin-left:auto;font-size:7px;color:rgba(255,255,255,0.75);\">4 langkah</span></div><div style=\"padding:7px 10px;display:flex;flex-direction:column;gap:3px;\"><div style=\"display:flex;align-items:center;gap:4px;\"><svg width=\"8\" height=\"8\" viewBox=\"0 0 24 24\" fill=\"#f59e0b\"><circle cx=\"12\" cy=\"12\" r=\"6\"/></svg><span style=\"font-size:8px;color:#0f172a;font-weight:500;\">Configure Parameters</span></div><div style=\"display:flex;align-items:center;gap:4px;\"><svg width=\"8\" height=\"8\" viewBox=\"0 0 24 24\" fill=\"#cbd5e1\"><circle cx=\"12\" cy=\"12\" r=\"6\"/></svg><span style=\"font-size:8px;color:#94a3b8;\">Build Flow</span></div><div style=\"display:flex;align-items:center;gap:4px;\"><svg width=\"8\" height=\"8\" viewBox=\"0 0 24 24\" fill=\"#cbd5e1\"><circle cx=\"12\" cy=\"12\" r=\"6\"/></svg><span style=\"font-size:8px;color:#94a3b8;\">Use Condition</span></div><div style=\"display:flex;align-items:center;gap:4px;\"><svg width=\"8\" height=\"8\" viewBox=\"0 0 24 24\" fill=\"#cbd5e1\"><circle cx=\"12\" cy=\"12\" r=\"6\"/></svg><span style=\"font-size:8px;color:#94a3b8;\">Review &amp; Submit</span></div></div></div></div>"
