            "3": "<div style=\"font-family:system-ui,-apple-system,sans-serif;border-radius:8px;background:linear-gradient(135deg,#f8fafc,#f1f5f9);border:1px solid #e2e8f0;overflow:hidden;padding:8px 12px;display:flex;align-items:center;gap:10px;\"><div style=\"display:flex;gap:4px;align-items:center;\"><div style=\"padding:5px 8px;border-radius:5px;background:#fff;border:1.5px solid #6366f1;font-size:7px;font-weight:700;color:#6366f1;box-shadow:0 1px 3px rgba(99,102,241,0.1);\">AMOUNT &gt; 10jt</div><svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#94a3b8\" stroke-width=\"2\"><path d=\"M5 12h14M12 5l7 7-7 7\"/></svg><div style=\"padding:5px 8px;border-radius:5px;background:#fff;border:1.5px solid #10b981;font-size:7px;font-weight:700;color:#10b981;box-shadow:0 1px 3px rgba(16,185,129,0.1);\">HIGH VALUE</div><svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#94a3b8\" stroke-width=\"2\"><path d=\"M5 12h14M12 5l7 7-7 7\"/></svg><div style=\"padding:5px 8px;border-radius:5px;background:#fff;border:1.5px solid #f59e0b;font-size:7px;font-weight:700;color:#f59e0b;box-shadow:0 1px 3px rgba(245,158,11,0.1);\">ALERT</div></div><span style=\"font-size:7px;color:#64748b;margin-left:auto;\">IF → THEN → ALERT</span></div>"
          }
