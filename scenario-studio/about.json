border-radius:6px;background:#fff;border:1.5px solid #6366f1;font-size:7px;font-weight:700;color:#6366f1;\">IF</div><svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#94a3b8\" stroke-width=\"1.5\"><path d=\"M5 12h14M12 5l7 7-7 7\"/></svg><div style=\"padding:4px 8px;border-radius:6px;background:#fff;border:1.5px solid #3b82f6;font-size:7px;font-weight:700;color:#3b82f6;\">THEN</div></div></div></div>",
            "2": "<div style=\"font-family:system-ui,-apple-system,sans-serif;border-radius:6px;background:#f8fafc;border:1px solid #e2e8f0;padding:6px 10px;display:flex;align-items:center;justify-content:space-between;\"><div style=\"display:flex;align-items:center;gap:6px;\"><svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#475569\" stroke-width=\"1.5\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"M12 6v6l4 2\"/></svg><span style=\"font-size:8px;color:#475569;font-weight:500;\">Info Rule</span></div><div style=\"display:flex;gap:4px;\"><span style=\"font-size:7px;padding:2px 6px;border-radius:4px;background:#6366f1;color:#fff;font-weight:600;\">+ Condition</span><span style=\"font-size:7px;padding:2px 6px;border-radius:4px;background:#f1f5f9;color:#64748b;\">Auto</span><span style=\"font-size:7px;padding:2px 6px;border-radius:4px;background:#f1f5f9;color:#64748b;\">Back</span><span style=\"font-size:7px;padding:2px 6px;border-radius:4px;background:#f1f5f9;color:#64748b;\">Next</span></div></div>"
