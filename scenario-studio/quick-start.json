          "previewHtml": "<div class=\"flex items-center gap-3 p-4\"><div class=\"flex-shrink-0 w-10 h-10 rounded-lg bg-blue-100 flex items-center justify-center\"><svg class=\"w-5 h-5 text-blue-600\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6\"/></svg></div><div><p class=\"font-semibold text-blue-900\">Scenario Management</p><p class=\"text-sm text-blue-700\">Menu utama \u2192 Scenario Management</p><kbd class=\"px-2 py-0.5 bg-blue-100 border border-blue-300 rounded text-xs text-blue-800\">Sidebar</kbd></div></div>"
