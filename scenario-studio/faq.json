          "bg": "#fdf2f8",
          "previewHtml": "<div class=\"flex flex-col gap-3 p-4\"><div class=\"flex items-center gap-3 rounded-lg border border-red-200 bg-red-50 p-3\"><svg class=\"h-6 w-6 flex-shrink-0 text-red-500\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z\"/></svg><div class=\"text-sm text-red-800\"><span class=\"font-semibold\">Validation Error</span><p class=\"mt-0.5 text-red-600\">Field \"Rule Name\" is required</p></div></div><div class=\"flex items-center gap-2 text-sm text-gray-500\"><svg class=\"h-4 w-4 text-pink-400\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z\"/></svg><span>Check all required fields in Step 1</span></div></div>"
