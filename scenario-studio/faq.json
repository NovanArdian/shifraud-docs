          "bg": "#eff6ff",
          "previewHtml": "<div class=\"flex flex-col gap-3 p-4\"><div class=\"flex items-center gap-2 rounded-lg bg-blue-50 p-3\"><svg class=\"h-5 w-5 text-blue-600\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 4v16m8-8H4\"/></svg><span class=\"text-sm font-medium text-blue-800\">Add Condition</span></div><div class=\"flex flex-col gap-2 text-sm text-gray-600\"><div class=\"flex items-center gap-2\"><span class=\"inline-flex h-5 w-5 items-center justify-center rounded bg-blue-100 text-xs font-bold text-blue-700\">1</span>Toolbar button</div><div class=\"flex items-center gap-2\"><span class=\"inline-flex h-5 w-5 items-center justify-center rounded bg-blue-100 text-xs font-bold text-blue-700\">2</span>Sidebar click</div><div class=\"flex items-center gap-2\"><span class=\"inline-flex h-5 w-5 items-center justify-center rounded bg-blue-100 text-xs font-bold text-blue-700\">3</span>Double-click placeholder</div></div></div>"
