          "color": "#14b8a6",
          "bg": "#f0fdfa",
          "previewHtml": {
            "1": "<div style=\"font-family:system-ui,-apple-system,sans-serif;border-radius:10px;box-shadow:0 1px 2px rgba(0,0,0,.04),0 1px 6px rgba(0,0,0,.06);background:#fff;border:1px solid #99f6e4;overflow:hidden;padding:10px 12px;display:flex;gap:12px;align-items:center;justify-content:center;\"><div style=\"display:flex;align-items:center;gap:4px;\"><div style=\"width:14px;height:14px;border-radius:3px;background:#22c55e;\"></div><span style=\"font-size:7px;font-weight:600;color:#16a34a;\">True</span></div><div style=\"display:flex;align-items:center;gap:4px;\"><div style=\"width:14px;height:14px;border-radius:3px;background:#ef4444;\"></div><span style=\"font-size:7px;font-weight:600;color:#dc2626;\">False</span></div><div style=\"display:flex;align-items:center;gap:4px;\"><div style=\"width:14px;height:14px;border-radius:3px;background:#e2e8f0;\"></div><span style=\"font-size:7px;font-weight:600;color:#64748b;\">Not Executed</span></div></div>"
          }
