          "bg": "#eff6ff",
          "previewHtml": {
            "1": "<div style=\"font-family:system-ui,-apple-system,sans-serif;border-radius:10px;box-shadow:0 1px 2px rgba(0,0,0,.04),0 1px 6px rgba(0,0,0,.06);background:#fff;border:1px solid #bfdbfe;overflow:hidden;padding:10px 12px;display:flex;gap:6px;flex-wrap:wrap;justify-content:center;\"><span style=\"padding:4px 10px;border-radius:5px;background:#eff6ff;border:1px solid #bfdbfe;font-size:7px;font-weight:600;color:#2563eb;\">\ud83d\uddb1\ufe0f Klik</span><span style=\"padding:4px 10px;border-radius:5px;background:#eff6ff;border:1px solid #bfdbfe;font-size:7px;font-weight:600;color:#2563eb;\">\u21e7 Shift+Klik</span><span style=\"padding:4px 10px;border-radius:5px;background:#eff6ff;border:1px solid #bfdbfe;font-size:7px;font-weight:600;color:#2563eb;\">\ud83d\udcd0 Drag box</span><span style=\"padding:4px 10px;border-radius:5px;background:#eff6ff;border:1px solid #bfdbfe;font-size:7px;font-weight:600;color:#2563eb;\">\u2328 Ctrl+A</span></div>"
          }
        },
        {
          "num": 2,
