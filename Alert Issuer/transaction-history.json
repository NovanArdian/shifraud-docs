          "bg": "#eef2ff",
          "previewHtml": {
            "1": "<div style=\"font-family:system-ui,-apple-system,sans-serif;border-radius:14px;box-shadow:0 1px 2px rgba(0,0,0,.04),0 1px 6px rgba(0,0,0,.06);background:#fff;border:1px solid #c7d2fe;overflow:hidden;\"><div style=\"padding:12px 14px;\"><div style=\"padding:8px 10px;border-radius:8px;background:#fef2f2;border:2px solid #dc2626;margin-bottom:6px;\"><div style=\"display:flex;justify-content:space-between;align-items:center;margin-bottom:2px;\"><span style=\"font-size:9px;font-weight:700;color:#0f172a;\">Jan 15, 2024 14:30</span><span style=\"font-size:10px;font-weight:800;color:#dc2626;\">Rp 25,000,000</span></div><div style=\"font-size:8px;color:#64748b;\">Online Shop XYZ • E-Commerce • Jakarta</div><div style=\"margin-top:4px;\"><span style=\"padding:2px 6px;border-radius:4px;background:#dc2626;font-size:7px;font-weight:700;color:#fff;\">🚨 TRIGGERED ALERT</span></div></div><div style=\"padding:6px 10px;border-radius:6px;background:#f8fafc;border:1px solid #e2e8f0;margin-bottom:4px;\"><div style=\"display:flex;justify-content:space-between;align-items:center;\"><span style=\"font-size:9px;color:#0f172a;\">Jan 14, 2024 10:15</span><span style=\"font-size:9px;font-weight:600;color:#0f172a;\">Rp 500,000</span></div><div style=\"font-size:8px;color:#64748b;\">Coffee Shop • F&B • Jakarta</div></div><div style=\"padding:6px 10px;border-radius:6px;background:#f8fafc;border:1px solid #e2e8f0;margin-bottom:4px;\"><div style=\"display:flex;justify-content:space-between;align-items:center;\"><span style=\"font-size:9px;color:#0f172a;\">Jan 13, 2024 16:45</span><span style=\"font-size:9px;font-weight:600;color:#0f172a;\">Rp 1,200,000</span></div><div style=\"font-size:8px;color:#64748b;\">Grocery Store • Retail • Jakarta</div></div></div></div>"
          }
        },
        {
