font-size:9px;font-weight:800;color:#64748b;text-transform:uppercase;letter-spacing:1px;\">General Information</span></div><div style=\"background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:10px;display:grid;grid-template-columns:1fr 1fr;gap:10px;\"><div><div style=\"font-size:8px;font-weight:700;color:#64748b;text-transform:uppercase;\">STAN</div><div style=\"font-size:10px;font-weight:700;color:#0f172a;\">123456</div></div><div><div style=\"font-size:8px;font-weight:700;color:#64748b;text-transform:uppercase;\">RRN</div><div style=\"font-size:10px;font-weight:700;color:#0f172a;\">098765432112</div></div></div></div><div><div style=\"display:flex;align-items:center;gap:6px;margin-bottom:6px;\"><svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#3b82f6\" stroke-width=\"2\"><path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"/><path d=\"M9 12l2 2 4-4\"/></svg><span style=\"font-size:9px;font-weight:800;color:#64748b;text-transform:uppercase;letter-spacing:1px;\">Security & Authentication</span></div><div style=\"background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:10px;\"><div style=\"display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-bottom:10px;\"><div style=\"background:#f1f5f9;border-radius:4px;padding:4px 8px;display:flex;justify-content:space-between;align-items:center;\"><span style=\"font-size:9px;font-weight:700;color:#0f172a;\">PIN Auth</span><span style=\"font-size:9px;font-weight:800;color:#3b82f6;\">Y</span></div><div style=\"background:#f1f5f9;border-radius:4px;padding:4px 8px;display:flex;justify-content:space-between;align-items:center;\"><span style=\"font-size:9px;font-weight:700;color:#0f172a;\">CVV Auth</span><span style=\"font-size:9px;font-weight:800;color:#3b82f6;\">M</span></div></div><div style=\"display:flex;gap:8px;\"><span style=\"padding:4px 8px;background:#eff6ff;color:#1d4ed8;font-size:9px;font-weight:700;border-radius:12px;\">Cross Border: false</span><span style=\"pa