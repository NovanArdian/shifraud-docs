=\"#7c3aed\" stroke-width=\"2.5\"><circle cx=\"12\" cy=\"12\" r=\"2\"/></svg></div><div style=\"font-size:7.5px;font-weight:700;color:#94a3b8;text-transform:uppercase;\">Attr Name</div></div><div style=\"font-size:10px;font-weight:700;color:#0f172a;\">customer_age</div></div><div><div style=\"display:flex;align-items:center;gap:4px;margin-bottom:3px;\"><div style=\"width:18px;height:18px;border-radius:4px;background:#ccfbf1;display:flex;align-items:center;justify-content:center;\"><svg width=\"9\" height=\"9\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#0d9488\" stroke-width=\"2.5\"><path d=\"M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z\"/></svg></div><div style=\"font-size:7.5px;font-weight:700;color:#94a3b8;text-transform:uppercase;\">Field Tag</div></div><div style=\"font-size:10px;font-weight:700;color:#0f172a;\">CUST_AGE</div></div><div><div style=\"display:flex;align-items:center;gap:4px;margin-bottom:3px;\"><div style=\"width:18px;height:18px;border-radius:4px;background:#fff3cd;display:flex;align-items:center;justify-content:center;\"><svg width=\"9\" height=\"9\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#d97706\" stroke-width=\"2.5\"><circle cx=\"12\" cy=\"12\" r=\"2\"/></svg></div><div style=\"font-size:7.5px;font-weight:700;color:#94a3b8;text-transform:uppercase;\">Type</div></div><span style=\"padding:2px 6px;border-radius:4px;background:#fee2e2;font-size:8px;font-weight:700;color:#dc2626;\">MERCHANT</span></div><div><div style=\"display:flex;align-items:center;gap:4px;margin-bottom:3px;\"><div style=\"width:18px;height:18px;border-radius:4px;background:#f3f4f6;display:flex;align-items:center;justify-content:center;\"><svg width=\"9\" height=\"9\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#6b7280\" stroke-width=\"2.5\"><circle cx=\"12\" cy=\"12\" r=\"2\"/></svg></div><div style=\"font-size:7.5px;font-weight:700;color:#94a3b8;text-transform:uppercase;\">Data Type</div></div><span style=\"padding:2px 6px;border-ra