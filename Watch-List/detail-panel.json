ef2ff;font-size:9px;font-weight:700;color:#6366f1;text-align:center;\">✏ Edit Entry</div><div style=\"padding:5px 8px;border-radius:6px;background:#fef2f2;font-size:9px;font-weight:700;color:#ef4444;text-align:center;\">🗑 Delete Entry</div><div style=\"padding:5px 8px;border-radius:6px;background:#6366f1;font-size:9px;font-weight:700;color:#fff;text-align:center;\">↗ Review Details</div></div></div><div style=\"flex:1;padding:14px;\"><div style=\"font-size:8px;font-weight:800;color:#94a3b8;text-transform:uppercase;letter-spacing:.06em;margin-bottom:10px;\">Watch List Metadata</div><div style=\"display:flex;flex-direction:column;gap:8px;\"><div style=\"display:flex;align-items:flex-start;gap:8px;\"><div style=\"width:22px;height:22px;border-radius:5px;background:#eef2ff;display:flex;align-items:center;justify-content:center;flex-shrink:0;\"><svg width=\"11\" height=\"11\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#6366f1\" stroke-width=\"2.5\"><path d=\"M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z\"/><line x1=\"7\" y1=\"7\" x2=\"7.01\" y2=\"7\"/></svg></div><div><div style=\"font-size:8px;font-weight:800;color:#94a3b8;text-transform:uppercase;\">List Name</div><div style=\"font-size:11px;font-weight:700;color:#0f172a;\">High-Risk IP Addresses</div></div></div><div style=\"display:flex;align-items:flex-start;gap:8px;\"><div style=\"width:22px;height:22px;border-radius:5px;background:#f0fdf4;display:flex;align-items:center;justify-content:center;flex-shrink:0;\"><svg width=\"11\" height=\"11\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#059669\" stroke-width=\"2.5\"><path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z\"/><polyline points=\"14 2 14 8 20 8\"/></svg></div><div><div style=\"font-size:8px;font-weight:800;color:#94a3b8;text-transform:uppercase;\">User Group</div><div style=\"font-size:11px;font-weight:700;color:#0f172a;\">RISK-OPS</div></div></div><div style=\"display:flex;align-items:flex-start;gap:8px;\"><div style=\"width:22px;height:22px;border-radius:5px;background:#fefce8;display:flex;align-items:center;justify-content:center;flex-shrink:0;\"><svg width=\"11\" height=\"11\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#d97706\" stroke-width=\"2.5\"><path d=\"M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z\"/><line x1=\"12\" y1=\"9\" x2=\"12\" y2=\"13\"/><line x1=\"12\" y1=\"17\" x2=\"12.01\" y2=\"17\"/></svg></div><div><div style=\"font-size:8px;font-weight:800;color:#94a3b8;text-transform:uppercase;\">Reason</div><div style=\"font-size:11px;font-weight:700;color:#0f172a;\">Known proxy & VPN IPs for fraud</div></div></div></div></div></div></div>"
          }
        },
        {
          "num": 2,
          "title": "Tab History — Audit Timeline",
          "desc": "{previewHtml:1}\n• Klik tab **History** untuk melihat jejak rekam seluruh perubahan pada Watch List ini.\n• Riwayat dimuat secara *lazy* — data baru di-fetch dari server saat tab pertama kali dibuka.\n• Ditampilkan dalam format **timeline** vertikal dengan titik-titik berwarna sebagai penanda setiap kejadian.\n• Jika riwayat cukup panjang, tombol **Expand Timeline** (ikon panah keluar) akan muncul di pojok kanan untuk membuka timeline dalam tampilan *full-screen modal*.",
          "color": "#10b981",
          "bg": "#f0fdf4",
          "previewHtml": {
            "1": "<div style=\"font-family:system-ui,-apple-system,sans-serif;border-radius:14px;overflow:hidden;box-shadow:0 4px 20px rgba(0,0,0,.1);border:1px solid #e2e8f0;background:#fff;width:320px;margin:0 auto;\"><div style=\"padding:10px 14px;border-bottom:1px solid #f1f5f9;display:flex;justify-content:space-between;align-items:center;background:#f8fafc;\"><div style=\"display:flex;gap:10px;\"><div style=\"padding:5px 12px;border-radius:20px;font-size:10px;font-weight:600;color:#94a3b8;border:1px solid #e2e8f0;\">General</div><div style=\"padding:5px 12px;border-radius:20px;font-size:10px;font-weight:700;color:#10b981;background:#f0fdf4;border:1px solid #bbf7d0;display:flex;align-items:center;gap:5px;\"><svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><polyline points=\"12 6 12 12 16 14\"/></svg>History</div></div><div style=\"padding:4px 10px;border-radius:20px;background:#f0fdf4;font-size:9px;font-weight:700;color:#10b981;border:1px solid #bbf7d0;\">↗ Expand Timeline</div></div><div style=\"padding:16px;\"><div style=\"position:relative;padding-left:20px;\"><div style=\"position:absolute;left:5px;top:6px;bottom:6px;width:2px;background:linear-gradient(to bottom,#3b82f6,#10b981,#94a3b8);\"></div><div style=\"display:flex;flex-direction:column;gap:14px;\"><div style=\"display:flex;gap:10px;align-items:flex-start;position:relative;\"><div style=\"width:12px;height:12px;border-radius:50%;background:#3b82f6;border:2px solid #fff;box-shadow:0 0 0 2px #bfdbfe;flex-shrink:0;margin-top:1px;\"></div><div><div style=\"font-size:11px;font-weight:700;color:#0f172a;\">Updated by admin@risk.co</div><div style=\"font-size:9px;color:#64748b;margin-top:1px;\">16 Jun 2025, 14:30 — Added 250 new IP entries</div></div></div><div style=\"display:flex;gap:10px;align-items:flex-start;position:relative;\"><div style=\"width:12px;height:12px;border-radius:50%;background:#10b981;border:2px solid #fff;box-shadow:0 0 0 2px #bbf7d0;flex-shrink:0;margin-top:1px;\"></div><div><div style=\"font-size:11px;font-weight:700;color:#0f172a;\">Created by analyst@risk.co</div><div style=\"font-size:9px;color:#64748b;margin-top:1px;\">15 Jun 2025, 10:00 — Initial watch list creation</div></div></div><div style=\"display:flex;gap:10px;align-items:flex-start;position:relative;\"><div style=\"width:12px;height:12px;border-radius:50%;background:#94a3b8;border:2px solid #fff;box-shadow:0 0 0 2px #e2e8f0;flex-shrink:0;margin-top:1px;\"></div><div><div style=\"font-size:11px;font-weight:600;color:#64748b;\">System initialized entry</div><div style=\"font-size:9px;color:#94a3b8;margin-top:1px;\">15 Jun 2025, 09:55</div></div></div></div></div></div></div>"
